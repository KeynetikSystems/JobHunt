# Tavily (search) — https://app.tavily.com
TAVILY_API_KEY=

# Groq (summarization) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic — optional. If set alongside GROQ_API_KEY, the LLM step fails over
# between the two automatically (see digest_engine.py's _llm_chain()). Safe to
# leave unset; a Groq-only setup behaves exactly as if this code didn't exist.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# failover (default) | roundrobin | single
LLM_STRATEGY=
# Optional: pin a specific model (e.g. a claude-* id) just for application-materials
# drafting, separate from whatever handles bulk search classification.
LLM_DRAFT_MODEL=

# Off by default (deliberate — see CHANGELOG.md). Set to true to also search for
# and summarize PE/VC/impact/consulting news alongside job listings.
ENABLE_NEWS=

# Where the digest gets emailed to
DIGEST_TO_EMAIL=

# Resend (https://resend.com) — sends verification/recovery/digest emails over
# HTTPS. Not raw SMTP: PaaS hosts (confirmed on Railway) commonly block outbound
# SMTP ports to curb spam abuse, while HTTPS is unaffected.
RESEND_API_KEY=
# Defaults to Resend's sandbox address (works without a verified domain, but can
# only deliver to the Resend account's own owner). Set to a verified domain's
# address for real users, e.g. noreply@yourdomain.com.
RESEND_FROM=onboarding@resend.dev
