# Tavily (search) — https://app.tavily.com
TAVILY_API_KEY=

# Groq (summarization) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Where the digest gets emailed to
DIGEST_TO_EMAIL=

# SMTP account used to send it (for Gmail: an App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Backend only: one shared Telegram bot used to push scheduled-scan alerts to
# premium users. Create a bot via @BotFather, paste its token here. Each user
# supplies their own chat_id via PUT /api/alerts — the bot token is never per-user.
TELEGRAM_BOT_TOKEN=
